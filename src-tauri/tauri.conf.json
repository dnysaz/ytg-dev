{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "youtube-terminal-gui",
  "version": "0.1.1",
  "identifier": "com.terminal.youtube",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "YouTube Terminal GUI - Player Fixed On Top",
        "width": 1200,
        "height": 750,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "category": "Entertainment",
    "shortDescription": "YouTube search, player and downloader in a terminal-style window",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
